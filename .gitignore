# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
!.env.example
!.env.production.example

# prisma generated client
/src/generated/

# never commit real Excel budget files
*.xls
*.xlsx
*.xlsm
# anonymized test fixtures only
!src/**/__fixtures__/*.xlsx

# Claude desktop outputs
/Claude outputs/

# Exports de base (pg_dump) : jamais commités
*.dump

# Relevés bancaires réels (CSV) : jamais commités (exemples anonymisés seulement)
*.csv
!src/**/__fixtures__/*.csv

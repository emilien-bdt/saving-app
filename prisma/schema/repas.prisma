// Module Repas. Dates are calendar dates (@db.Date, UTC-midnight Date objects).
// CHECK constraints live in the migration SQL:
// - LEFTOVER ⇒ dishId NOT NULL ; DISH ⇒ dishId facultatif (null = accompagnements seuls) ;
//   OUT ⇒ dishId NULL AND label NOT NULL ;
// - non-empty dish name / key; label and note lengths;
// - ingredient name length, positive amounts and pack sizes.

enum RepasSlot {
  LUNCH
  DINNER
}

enum RepasMealKind {
  /// Cooked at home.
  DISH
  /// Leftover of a dish cooked earlier (dishId = the cooked dish).
  LEFTOVER
  /// Nobody eats at home: "Absent", "Restaurant…", "Chez maman"…
  OUT
}

enum RepasMealStatus {
  /// Proposed (by hand or by the generator): may be regenerated.
  PROPOSED
  /// Locked: the generator never touches it.
  VALIDATED
}

model RepasDish {
  id        String      @id @default(cuid())
  name      String
  /// Normalised name (domain/dish-key.ts), unique: "Pâtes carbo" = "pates carbo".
  key       String      @unique
  /// Archived dishes are never proposed by the generator.
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  meals       RepasMeal[]
  ingredients RepasDishIngredient[]

  @@map("repas_dish")
}

model RepasMeal {
  id        String          @id @default(cuid())
  date      DateTime        @db.Date
  slot      RepasSlot
  kind      RepasMealKind
  dishId    String?
  dish      RepasDish?      @relation(fields: [dishId], references: [id], onDelete: Restrict)
  label     String?
  note      String?
  status    RepasMealStatus @default(PROPOSED)
  /// Set by the Excel import ("excel:2026-03-24:LUNCH"): re-import is idempotent.
  importRef String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sides     RepasMealSide[]

  @@unique([date, slot])
  @@index([dishId])
  @@map("repas_meal")
}

/// Aisles in the order of the Courses U drive (shopping list order).
enum RepasAisle {
  FRUITS_LEGUMES
  BOUCHERIE_POISSON
  CHARCUTERIE_TRAITEUR
  CREMERIE
  EPICERIE_SALEE
  EPICERIE_SUCREE
  SURGELES
  BOULANGERIE
  BOISSONS
  HYGIENE_ENTRETIEN
  AUTRE
}

enum RepasUnit {
  PIECE
  G
  ML
}

/// Shared ingredient catalogue: the same ingredient adds up across dishes.
model RepasIngredient {
  id         String                @id @default(cuid())
  name       String
  /// Normalised name (domain/ingredients.ts ingredientKey): "Œufs" = "oeuf".
  key        String                @unique
  aisle      RepasAisle            @default(AUTRE)
  /// Unit of every amount of this ingredient.
  unit       RepasUnit             @default(PIECE)
  /// Size of what is bought (200 for a 200 g pack); null = sold by the unit.
  packAmount Int?
  /// Side item (chips, salade…): split from dish names, offered in the meal editor.
  side       Boolean               @default(false)
  /// Staple (lait, beurre…): added to the shopping list in one tap.
  staple     Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  dishes     RepasDishIngredient[]
  meals      RepasMealSide[]
  shopping   RepasShoppingItem[]

  @@map("repas_ingredient")
}

/// Ingredient of a dish, for one meal for 2 people.
model RepasDishIngredient {
  id           String          @id @default(cuid())
  dishId       String
  dish         RepasDish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   RepasIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  /// In the ingredient's unit; null = quantity not known yet.
  amount       Int?
  /// Guessed from the Excel history, not reviewed yet.
  suggested    Boolean         @default(false)
  sortOrder    Int             @default(0)

  @@unique([dishId, ingredientId])
  @@index([ingredientId])
  @@map("repas_dish_ingredient")
}

/// Side item of a meal (bought as is, not part of the dish's recipe).
model RepasMealSide {
  id           String          @id @default(cuid())
  mealId       String
  meal         RepasMeal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   RepasIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sortOrder    Int             @default(0)

  @@unique([mealId, ingredientId])
  @@index([ingredientId])
  @@map("repas_meal_side")
}

enum RepasShoppingSource {
  /// Computed from the week's meals (the row only stores what was done on the line).
  MEALS
  /// Basic added in one tap.
  STAPLE
  /// Typed by hand.
  MANUAL
}

/// One line of a week's shopping list, per ingredient.
model RepasShoppingItem {
  id           String              @id @default(cuid())
  /// Monday of the week.
  weekStart    DateTime            @db.Date
  ingredientId String
  ingredient   RepasIngredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  source       RepasShoppingSource
  /// Quantity set by hand (in the ingredient's unit); null = computed / unknown.
  amount       Int?
  checked      Boolean             @default(false)
  /// "Déjà au placard": a computed line not to buy.
  removed      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([weekStart, ingredientId])
  @@index([ingredientId])
  @@map("repas_shopping_item")
}

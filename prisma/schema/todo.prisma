// Module To do. Due dates are calendar dates (@db.Date, UTC-midnight Date objects).
// CHECK constraints (non-empty title/name, colour format) live in the migration SQL.

enum TodoPriority {
  NORMAL
  HIGH
}

model TodoList {
  id          String     @id @default(cuid())
  /// Who created it (a personal list is only theirs).
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set = shared with this household (every member sees and edits its tasks).
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Unique per owner / household (case-insensitive): checked in code.
  name      String
  color     String     @default("#64748b")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tasks     TodoTask[]

  @@index([userId])
  @@index([householdId])
  @@map("todo_list")
}

model TodoTask {
  id          String       @id @default(cuid())
  /// Who created it; tasks of a shared list are seen by the whole household.
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  note        String?
  /// Optional due date; null = "Sans date".
  dueDate     DateTime?    @db.Date
  priority    TodoPriority @default(NORMAL)
  /// Deleting a list keeps its tasks (they go back to "Sans liste").
  listId      String?
  list        TodoList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// null = to do; set = done (date and time it was ticked).
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([completedAt, dueDate])
  @@index([listId])
  @@index([userId])
  @@map("todo_task")
}

# Local database (docker compose up -d)
DATABASE_URL="postgresql://save:save@localhost:5432/save?schema=public"

# Authentication: `npm run auth:hash` fills these two lines (copy them to the server .env too).
# AUTH_PASSWORD_HASH (former single password) only signs in the migrated « admin » account
# until it chooses its own password in Réglages.
AUTH_SECRET=""
AUTH_PASSWORD_HASH=""

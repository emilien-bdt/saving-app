# Copier en .env sur le serveur (à côté de docker-compose.prod.yml).

# Fait utiliser docker-compose.prod.yml par un simple `docker compose …`
COMPOSE_FILE=docker-compose.prod.yml

# Mot de passe Postgres : uniquement lettres/chiffres (il va dans une URL) → openssl rand -hex 24
POSTGRES_PASSWORD=""

# Mot de passe de l'app : `npm run auth:hash` sur le Mac, recopier les deux lignes affichées
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# Réseau Docker du conteneur nginx (docker network ls / docker inspect <nginx>)
PROXY_NETWORK=""
